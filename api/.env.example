# --- Obrigatórias -----------------------------------------------------------

PORT=3333

# Postgres. Dentro do Easypanel, o host é o nome interno do serviço de banco
# no formato <projeto>_<servico> (ex.: drb_telegas-db).
DATABASE_URL=postgres://usuario:senha@localhost:5432/telegas

# Segredo de assinatura dos JWT (painel e app do entregador).
# Gere um valor aleatório: openssl rand -base64 48
# Sem esta variável a API usa um fallback embutido no código — nunca em produção.
JWT_SECRET=

# --- Notificações push do app do entregador ---------------------------------
# Se ficarem vazias, a API gera um par de chaves a cada boot e imprime no log —
# o que invalida todas as inscrições existentes a cada deploy. Gere uma vez
# (npx web-push generate-vapid-keys) e fixe aqui.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@telegas.com.br

# --- Integrações ------------------------------------------------------------

# Avisa o fluxo n8n quando um pedido é concluído ou cancelado pelo painel,
# para que o bot notifique o cliente no WhatsApp. Opcional: se vazio, o painel
# funciona normalmente e apenas não dispara a notificação.
N8N_ACAO_WEBHOOK_URL=

# Evolution API — usada pela portaria para avisar o entregador do novo pedido.
# O código tem valores embutidos como fallback; defina aqui para sobrescrevê-los.
EVOLUTION_URL=https://evolution.comercialdrb.com.br
EVOLUTION_INSTANCE=
EVOLUTION_APIKEY=
